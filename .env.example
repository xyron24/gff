# Mastercard AI Defense Lab - Environment Configuration

# Application
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0

# LLM Providers (for Tier 3 SAR Generation)
# Free tier available at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional OpenAI fallback
OPENAI_API_KEY=your_openai_api_key_here

# Simulation Settings
DEFAULT_TPS=20
MAX_STREAM_BUFFER=1000
ENABLE_ONNX_ACCELERATION=true

# Storage Paths
DATA_DIR=data
MODEL_DIR=data/models
REGISTRY_DIR=identify/registry
